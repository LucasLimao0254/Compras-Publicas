DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres
# Obrigatório em qualquer ambiente — a API recusa subir sem isso (não há
# fallback hardcoded no código: um segredo padrão público permitiria forjar
# tokens válidos). Gere um valor aleatório por ambiente, ex.: openssl rand -hex 32
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio
PORT=3001
# CORS_ORIGIN=https://seu-frontend.exemplo.com

